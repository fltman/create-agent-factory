# Kopiera den här filen till .env och fyll i de nycklar du har.
# .env är gitignored. Agent Factory skapar den aldrig utan ditt godkännande.

# OpenRouter (används av gemini-imagegen)
OPENROUTER_API_KEY=

# OpenAI (används av sora-video)
OPENAI_API_KEY=

# ElevenLabs (används av elevenlabs-skill)
ELEVENLABS_API_KEY=
